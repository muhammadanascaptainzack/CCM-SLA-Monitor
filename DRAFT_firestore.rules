rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'anuslatif@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: AdminRecord
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: CustomerProfile
    function isValidCustomerProfile(data) {
      return data.keys().hasAll([
          'ownerUid', 'customerId', 'name', 'email', 'phone', 'cnic',
          'district', 'areaAddress', 'circuitId', 'bandwidthPlan',
          'connectionType', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'customerId', 'name', 'email', 'phone', 'cnic',
          'district', 'areaAddress', 'circuitId', 'bandwidthPlan',
          'connectionType', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.ownerUid == request.auth.uid || isAdmin()) &&
        data.customerId is string && data.customerId.size() >= 1 && data.customerId.size() <= 64 && data.customerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
        data.cnic is string && data.cnic.size() >= 5 && data.cnic.size() <= 25 &&
        data.district is string && data.district.size() >= 2 && data.district.size() <= 40 &&
        data.district in ['Faisalabad', 'Lahore', 'Multan', 'Rawalpindi', 'Islamabad'] &&
        data.areaAddress is string && data.areaAddress.size() >= 2 && data.areaAddress.size() <= 250 &&
        data.circuitId is string && data.circuitId.size() >= 2 && data.circuitId.size() <= 64 &&
        data.bandwidthPlan is string && data.bandwidthPlan.size() >= 2 && data.bandwidthPlan.size() <= 100 &&
        data.connectionType is string && data.connectionType.size() >= 2 && data.connectionType.size() <= 40 &&
        data.connectionType in ['FTTH', 'GPON', 'Wireless P2P', 'Copper DSL'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: CloudComplaint
    function isValidCloudComplaint(data) {
      return data.keys().hasAll([
          'ownerUid', 'ticketId', 'ticketNumber', 'customerId', 'customerName',
          'customerEmail', 'customerPhone', 'circuitId', 'district', 'category',
          'priority', 'status', 'subject', 'description', 'latestOnlineUpdate',
          'customerFeedbackComment', 'customerRating', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'ticketId', 'ticketNumber', 'customerId', 'customerName',
          'customerEmail', 'customerPhone', 'circuitId', 'district', 'category',
          'priority', 'status', 'subject', 'description', 'latestOnlineUpdate',
          'customerFeedbackComment', 'customerRating', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.ownerUid == request.auth.uid || isAdmin()) &&
        data.ticketId is string && data.ticketId.size() >= 1 && data.ticketId.size() <= 64 && data.ticketId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ticketNumber is string && data.ticketNumber.size() >= 3 && data.ticketNumber.size() <= 64 &&
        data.customerId is string && data.customerId.size() >= 1 && data.customerId.size() <= 64 &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerEmail is string && data.customerEmail.size() >= 5 && data.customerEmail.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 30 &&
        data.circuitId is string && data.circuitId.size() >= 2 && data.circuitId.size() <= 64 &&
        data.district is string && data.district.size() >= 2 && data.district.size() <= 40 &&
        data.district in ['Faisalabad', 'Lahore', 'Multan', 'Rawalpindi', 'Islamabad'] &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 50 &&
        data.category in [
          'OFC_CUT', 'SPEED_DEGRADATION', 'FREQUENT_DISCONNECT',
          'DNS_ROUTING', 'CPE_ONT_FAULT', 'BILLING_PAYMENT', 'NEW_PROVISIONING'
        ] &&
        data.priority is string && data.priority.size() >= 2 && data.priority.size() <= 30 &&
        data.priority in ['P1_CRITICAL', 'P2_MAJOR', 'P3_STANDARD'] &&
        data.status is string && data.status.size() >= 2 && data.status.size() <= 30 &&
        data.status in ['REGISTERED', 'ASSIGNED', 'IN_PROGRESS', 'ESCALATED_PTA', 'RESOLVED', 'CLOSED'] &&
        data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 200 &&
        data.description is string && data.description.size() >= 3 && data.description.size() <= 1500 &&
        data.latestOnlineUpdate is string && data.latestOnlineUpdate.size() >= 0 && data.latestOnlineUpdate.size() <= 500 &&
        data.customerFeedbackComment is string && data.customerFeedbackComment.size() >= 0 && data.customerFeedbackComment.size() <= 500 &&
        data.customerRating is number && data.customerRating >= 0 && data.customerRating <= 5 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection 1: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if false;
      allow create: if isBootstrappedAdmin() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminUid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(adminUid);
    }

    // Collection 2: /users/{userId} (Strict PII Isolation — Owner or Admin Only)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidCustomerProfile(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidCustomerProfile(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().customerId == existing().customerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            request.auth.uid == userId &&
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'cnic', 'district', 'areaAddress', 'bandwidthPlan', 'connectionType', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Collection 3: /complaints/{complaintId} (Customer Complaint History in Cloud)
    match /complaints/{complaintId} {
      allow get: if isSignedIn() && isValidId(complaintId) && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(complaintId) &&
        isValidCloudComplaint(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().ticketId == complaintId &&
        incoming().status == 'REGISTERED' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(complaintId) &&
        isValidCloudComplaint(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().ticketId == existing().ticketId &&
        incoming().ticketNumber == existing().ticketNumber &&
        incoming().customerId == existing().customerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().ownerUid == request.auth.uid &&
            existing().status != 'CLOSED' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'customerFeedbackComment', 'customerRating', 'status', 'latestOnlineUpdate', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );
      allow delete: if isAdmin() && isValidId(complaintId);
    }
  }
}
